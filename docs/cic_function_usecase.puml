@startuml CIC_Function_List

title Danh sách chức năng quản lý T1–T3\nHệ thống Quản trị Dữ liệu Tín dụng CIC

left to right direction

skinparam {
  BackgroundColor #FAFAFA
  ActorBackgroundColor #D6EAF8
  ActorBorderColor #2E86C1
  UsecaseBackgroundColor #FFFFFF
  UsecaseBorderColor #888888
  UsecaseBorderThickness 1
  PackageBackgroundColor #F4F6F7
  PackageBorderColor #AAB7B8
  PackageBorderThickness 1
  ArrowColor #555555
  DefaultFontName Arial
  DefaultFontSize 11
}

