@startuml DG_T1_T3_Functions

title Chức năng Quản trị Dữ liệu — Tầng T1 đến T3\n(Data Asset · Business/Technical Asset · Business Glossary · Business Rule · Data Model · Data Entity · Metadata)

left to right direction

skinparam {
  BackgroundColor #FAFAFA
  ActorBackgroundColor #D6EAF8
  ActorBorderColor #2E86C1
  UsecaseBackgroundColor #FFFFFF
  UsecaseBorderColor #999999
  UsecaseBorderThickness 1
  PackageBackgroundColor #F8F9FA
  PackageBorderColor #AAAAAA
  PackageBorderThickness 1.2
  ArrowColor #555555
  DefaultFontName Arial
  DefaultFontSize 11
  Nodesep 50
  Ranksep 60
}

' ============================================================
' ACTORS
' ============================================================
actor "Data Owner\n(Chủ dữ liệu)" as DO
actor "Data Steward\n(Quản lý DL)" as DS
actor "Data Analyst /\nDeveloper" as DA
actor "Business User\n(Người dùng NV)" as BU
actor "Hệ thống\n(Auto / API)" as SYS

' ============================================================
' T1 — QUẢN LÝ TÀI SẢN DỮ LIỆU (DATA ASSET)
' ============================================================
package "T1 · Quản lý Tài sản Dữ liệu (Data Asset)" #E8EAF6 {

  usecase "T1.1\nĐăng ký tài sản dữ liệu mới\n─────────────────\nNhập: tên, mô tả, loại (nghiệp vụ / kỹ thuật),\nmiền dữ liệu, nguồn gốc, mức độ quan trọng" as T1_1

  usecase "T1.2\nCập nhật thông tin tài sản\n─────────────────\nSửa mô tả, phân loại, trạng thái,\nngày hiệu lực, thẻ tag" as T1_2

  usecase "T1.3\nPhân loại & gắn nhãn tài sản\n─────────────────\nGắn: Domain, Sub-domain,\nloại (Business/Technical),\nmức độ nhạy cảm" as T1_3

  usecase "T1.4\nTra cứu & tìm kiếm tài sản\n─────────────────\nTìm kiếm full-text, lọc theo loại /\nDomain / trạng thái / người sở hữu" as T1_4

  usecase "T1.5\nXem toàn cảnh tài sản\n(Asset 360° View)\n─────────────────\nHiển thị: metadata, lineage,\nbusiness rules, quality score,\nai sở hữu, liên kết thực thể" as T1_5

  usecase "T1.6\nQuản lý vòng đời tài sản\n─────────────────\nCác trạng thái: Draft → Active\n→ Deprecated → Retired\nKèm lý do & lịch sử chuyển trạng thái" as T1_6

  usecase "T1.7\nGán Data Owner / Data Steward\ncho tài sản\n─────────────────\nChỉ định người chịu trách nhiệm\ntheo từng tài sản hoặc domain" as T1_7

  usecase "T1.8\nXem lịch sử thay đổi tài sản\n(Audit Trail)\n─────────────────\nAi thay đổi, thay đổi gì,\nlúc nào — không thể xóa log" as T1_8
}

' ============================================================
' T2A — QUẢN LÝ TÀI SẢN NGHIỆP VỤ (BUSINESS ASSET)
' ============================================================
package "T2A · Quản lý Tài sản Nghiệp vụ (Business Asset)" #E8F8F5 {

  usecase "T2A.1\nĐăng ký tài sản nghiệp vụ\n─────────────────\nKhai báo: tên nghiệp vụ, mô tả,\nquy trình liên quan, đơn vị sở hữu,\nmức độ quan trọng với tổ chức" as T2A_1

  usecase "T2A.2\nLiên kết tài sản NV → Thuật ngữ\n(→ T3: Business Glossary)\n─────────────────\nGắn tài sản với các thuật ngữ\nmô tả nó trong Business Glossary" as T2A_2

  usecase "T2A.3\nLiên kết tài sản NV → Quy tắc\n(→ T3: Business Rule)\n─────────────────\nXác định quy tắc nghiệp vụ\nnào áp dụng cho tài sản này" as T2A_3

  usecase "T2A.4\nLiên kết tài sản NV → Thực thể\n(→ T3: Data Entity)\n─────────────────\nChỉ rõ tài sản nghiệp vụ này\nđược lưu trữ trong thực thể nào" as T2A_4

  usecase "T2A.5\nXem tài sản NV theo Domain\n─────────────────\nLọc và xem toàn bộ tài sản NV\ntheo từng miền: KH, Tín dụng,\nRủi ro, Tài chính..." as T2A_5
}

' ============================================================
' T2B — QUẢN LÝ TÀI SẢN KỸ THUẬT (TECHNICAL ASSET)
' ============================================================
package "T2B · Quản lý Tài sản Kỹ thuật (Technical Asset)" #FEF9E7 {

  usecase "T2B.1\nĐăng ký tài sản kỹ thuật\n─────────────────\nKhai báo: tên bảng/file/API,\nhệ thống nguồn, schema, định dạng,\nlocation, công nghệ lưu trữ" as T2B_1

  usecase "T2B.2\nQuét & đồng bộ metadata kỹ thuật\n(Auto-discovery)\n─────────────────\nKết nối DB / API để tự động\nlấy: tên cột, kiểu dữ liệu,\nkích thước, nullable, index" as T2B_2

  usecase "T2B.3\nLiên kết tài sản KT → Tài sản NV\n─────────────────\nMapping: bảng/cột kỹ thuật\n↔ khái niệm nghiệp vụ tương ứng\n(business-to-technical mapping)" as T2B_3

  usecase "T2B.4\nQuản lý phiên bản schema\n─────────────────\nTheo dõi thay đổi cấu trúc:\nthêm cột, đổi kiểu, xóa bảng\nKèm impact analysis" as T2B_4

  usecase "T2B.5\nPhân tích tác động thay đổi\n(Impact Analysis)\n─────────────────\nKhi thay đổi 1 tài sản KT:\nhiển thị danh sách tài sản,\nbáo cáo, quy trình bị ảnh hưởng" as T2B_5
}

' ============================================================
' T3A — QUẢN LÝ THUẬT NGỮ NGHIỆP VỤ (BUSINESS GLOSSARY)
' ============================================================
package "T3A · Quản lý Thuật ngữ Nghiệp vụ (Business Glossary)" #E8F5E9 {

  usecase "T3A.1\nTạo mới thuật ngữ nghiệp vụ\n─────────────────\nNhập: tên thuật ngữ, định nghĩa,\ntên viết tắt, ví dụ minh họa,\nDomain, trạng thái, người duyệt" as T3A_1

  usecase "T3A.2\nCập nhật & quản lý phiên bản\nthuật ngữ\n─────────────────\nSửa định nghĩa → tạo phiên bản mới\nGiữ lịch sử, không xóa version cũ" as T3A_2

  usecase "T3A.3\nPhê duyệt thuật ngữ\n(Approval Workflow)\n─────────────────\nLuồng: Đề xuất → Review\n→ Approved / Rejected\nKèm comment của reviewer" as T3A_3

  usecase "T3A.4\nQuản lý quan hệ giữa thuật ngữ\n─────────────────\nXác định: đồng nghĩa (synonym),\ntrái nghĩa, cha-con (hierarchy),\nliên quan (related term)" as T3A_4

  usecase "T3A.5\nTra cứu thuật ngữ\n─────────────────\nTìm theo: tên, từ khóa, Domain,\ntrạng thái, người tạo\nHỗ trợ fuzzy search" as T3A_5

  usecase "T3A.6\nLiên kết thuật ngữ → Tài sản KT\n─────────────────\nGắn thuật ngữ NV với cột/bảng\nkỹ thuật tương ứng" as T3A_6

  usecase "T3A.7\nXuất Business Glossary\n─────────────────\nExport toàn bộ hoặc theo Domain\nra Excel / PDF / HTML" as T3A_7
}

' ============================================================
' T3B — QUẢN LÝ QUY TẮC NGHIỆP VỤ (BUSINESS RULE)
' ============================================================
package "T3B · Quản lý Quy tắc Nghiệp vụ (Business Rule)" #FFF3E0 {

  usecase "T3B.1\nTạo mới quy tắc nghiệp vụ\n─────────────────\nNhập: tên rule, mô tả ngôn ngữ tự nhiên,\nloại rule (validation / calculation /\ncondition / constraint),\nDomain, mức độ ưu tiên" as T3B_1

  usecase "T3B.2\nĐặc tả biểu thức logic của rule\n─────────────────\nDiễn đạt rule dạng:\n· Ngôn ngữ tự nhiên\n· Pseudo-code / SQL\n· Condition-Action" as T3B_2

  usecase "T3B.3\nLiên kết rule → Tài sản / Thực thể\n─────────────────\nXác định rule này áp dụng cho\ntài sản / thực thể / thuộc tính nào" as T3B_3

  usecase "T3B.4\nPhê duyệt quy tắc\n(Approval Workflow)\n─────────────────\nLuồng tương tự T3A.3\nCần Business Owner xác nhận" as T3B_4

  usecase "T3B.5\nKiểm thử / Validate rule\n─────────────────\nChạy rule trên tập dữ liệu mẫu\nXem kết quả pass/fail\nGhi nhận tỷ lệ vi phạm" as T3B_5

  usecase "T3B.6\nTra cứu & lọc quy tắc\n─────────────────\nLọc theo: loại, Domain,\ntài sản áp dụng, trạng thái,\nmức độ vi phạm" as T3B_6

  usecase "T3B.7\nTheo dõi vi phạm quy tắc\n(Rule Violation Monitoring)\n─────────────────\nDashboard: số lần vi phạm,\ntỷ lệ pass, xu hướng theo thời gian" as T3B_7

  usecase "T3B.8\nQuản lý vòng đời quy tắc\n─────────────────\nDraft → Active → Deprecated\nKèm lý do và version history" as T3B_8
}

' ============================================================
' T3C — QUẢN LÝ MÔ HÌNH DỮ LIỆU (DATA MODEL)
' ============================================================
package "T3C · Quản lý Mô hình Dữ liệu (Data Model)" #FCE4EC {

  usecase "T3C.1\nTạo & quản lý mô hình dữ liệu\n─────────────────\nKhai báo: tên model, loại\n(Conceptual / Logical / Physical),\nDomain, phiên bản, mô tả" as T3C_1

  usecase "T3C.2\nThiết kế thực thể & thuộc tính\ntrên mô hình\n─────────────────\nKéo thả hoặc khai báo dạng text:\nthực thể, thuộc tính, kiểu dữ liệu,\nkhóa chính / khóa ngoại" as T3C_2

  usecase "T3C.3\nXác định quan hệ giữa thực thể\n─────────────────\nKhai báo: 1:1 / 1:N / N:N\nCardinality, optional/mandatory\nTên vai trò của quan hệ" as T3C_3

  usecase "T3C.4\nLiên kết model với tầng\n(Conceptual ↔ Logical ↔ Physical)\n─────────────────\nMapping giữa 3 cấp độ model\nTheo dõi sự khác biệt (gap analysis)" as T3C_4

  usecase "T3C.5\nQuản lý phiên bản mô hình\n─────────────────\nGit-like versioning:\nxem diff giữa 2 phiên bản,\nrollback, branch, merge" as T3C_5

  usecase "T3C.6\nXuất mô hình\n─────────────────\nExport ra: PlantUML / ERD /\nDDL SQL / XMI / PDF\nHỗ trợ nhiều định dạng" as T3C_6
}

' ============================================================
' T3D — QUẢN LÝ THỰC THỂ DỮ LIỆU (DATA ENTITY)
' ============================================================
package "T3D · Quản lý Thực thể Dữ liệu (Data Entity)" #EDE7F6 {

  usecase "T3D.1\nĐăng ký thực thể dữ liệu\n─────────────────\nKhai báo: tên thực thể, mô tả NV,\nDomain, loại (master/transaction/\nreference/lookup)" as T3D_1

  usecase "T3D.2\nQuản lý thuộc tính của thực thể\n─────────────────\nThêm/sửa/xóa thuộc tính:\ntên, kiểu DL, độ dài, bắt buộc,\nmô tả NV, liên kết thuật ngữ" as T3D_2

  usecase "T3D.3\nXác định khóa định danh\n(PK / Natural Key / Surrogate Key)\n─────────────────\nKhai báo và giải thích\nchiến lược định danh thực thể" as T3D_3

  usecase "T3D.4\nLiên kết thực thể → Thuật ngữ NV\n(→ T3A: Business Glossary)\n─────────────────\nMapping: tên kỹ thuật ↔\ntên nghiệp vụ tương ứng" as T3D_4

  usecase "T3D.5\nLiên kết thực thể → Rule\n(→ T3B: Business Rule)\n─────────────────\nXác định những quy tắc nào\náp dụng cho thực thể này" as T3D_5

  usecase "T3D.6\nLiên kết thực thể → Tài sản KT\n(→ T2B: Technical Asset)\n─────────────────\nChỉ rõ thực thể này được lưu\nở bảng nào, hệ thống nào" as T3D_6

  usecase "T3D.7\nXem thực thể trên mô hình\n─────────────────\nClick vào thực thể → xem vị trí\ntrên Data Model, các quan hệ,\ntài sản và rule liên quan" as T3D_7
}

' ============================================================
' T3E — QUẢN LÝ METADATA
' ============================================================
package "T3E · Quản lý Metadata" #E3F2FD {

  usecase "T3E.1\nQuản lý metadata kỹ thuật\n─────────────────\nLưu & hiển thị: kiểu dữ liệu,\nđộ dài, nullable, default,\nindex, constraint, encoding" as T3E_1

  usecase "T3E.2\nQuản lý metadata nghiệp vụ\n─────────────────\nLưu & hiển thị: tên NV, định nghĩa,\nví dụ, quy tắc tính, đơn vị đo,\nnguồn dữ liệu, tần suất cập nhật" as T3E_2

  usecase "T3E.3\nQuản lý metadata vận hành\n─────────────────\nLưu & hiển thị: ngày tạo, ngày sửa,\nnhật ký thay đổi, phiên bản,\nngười tạo/sửa, trạng thái" as T3E_3

  usecase "T3E.4\nNhập metadata hàng loạt\n(Bulk Import)\n─────────────────\nUpload Excel/CSV để nhập\nhàng loạt metadata\nKèm validation trước khi lưu" as T3E_4

  usecase "T3E.5\nTìm kiếm theo metadata\n─────────────────\nTìm tài sản / thực thể dựa trên\ncác thuộc tính metadata:\nkiểu DL, domain, tag, trạng thái" as T3E_5

  usecase "T3E.6\nSo sánh metadata giữa\n2 phiên bản / 2 hệ thống\n─────────────────\nHiển thị diff:\nthêm / sửa / xóa thuộc tính" as T3E_6
}

' ============================================================
' MODULE NGANG: LIÊN KẾT & DATA LINEAGE
' ============================================================
package "MX · Liên kết & Truy vết (Linking & Lineage)" #F3E5F5 {

  usecase "MX.1\nXem sơ đồ lineage của tài sản\n─────────────────\nHiển thị: tài sản này\nđến từ đâu, đi về đâu\n(upstream / downstream)" as MX_1

  usecase "MX.2\nLiên kết ngang giữa T1–T3\n─────────────────\nData Asset ↔ Business Asset\n↔ Technical Asset ↔ Entity\n↔ Glossary ↔ Rule ↔ Metadata" as MX_2

  usecase "MX.3\nTìm kiếm toàn cục\n(Global Search)\n─────────────────\nTìm 1 từ khóa → trả kết quả\ntừ tất cả: asset, entity,\nglossary, rule, metadata" as MX_3

  usecase "MX.4\nDashboard tổng quan T1–T3\n─────────────────\nSố lượng: tài sản, thực thể,\nthuật ngữ, quy tắc, metadata\nTheo Domain / trạng thái / Owner" as MX_4
}

