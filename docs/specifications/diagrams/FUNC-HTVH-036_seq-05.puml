@startuml FUNC-HTVH-036_seq-05
title FEAT-HTVH-036-05 — Điều chỉnh trạng thái hoạt động và xóa Job

skinparam sequenceMessageAlign center
skinparam maxMessageSize 240

actor "Người dùng\n(ROLE-QTHT / ROLE-QLVH)" as NSD
participant "MH-HTVH-036-001\nDanh sách Job" as MH_DS
participant "Lớp nghiệp vụ\nuseJobManagement" as HT_LOGIC
participant "Dịch vụ Job\nHT-JOB" as HT_JOB
participant "Bộ lập lịch\nHT-SCH" as HT_SCH
database "CSDL" as CSDL

NSD -> MH_DS : Mở menu thao tác của một dòng
activate MH_DS
MH_DS -> MH_DS : Dựng mục menu theo quyền của vai trò\nvà theo trạng thái hiện tại của Job
MH_DS --> NSD : Danh sách mục khả dụng

== Điều chỉnh trạng thái hoạt động ==
alt Job đang ở trạng thái Hoạt động
  NSD -> MH_DS : Chọn "Vô hiệu hóa"
  MH_DS -> HT_LOGIC : Đổi trạng thái Job
  activate HT_LOGIC
  HT_LOGIC -> HT_JOB : Cập nhật trạng thái sang Ngừng hoạt động
  activate HT_JOB
  HT_JOB -> HT_SCH : Gỡ lịch chạy tự động
  HT_JOB -> CSDL : Cập nhật JOB_DEFINITION
  HT_JOB -> CSDL : Ghi JOB_AUDIT_HISTORY
  HT_JOB --> HT_LOGIC : Thành công
  deactivate HT_JOB
  HT_LOGIC --> MH_DS : Danh sách đã cập nhật
  deactivate HT_LOGIC
  MH_DS --> NSD : SUC_004 "Đã vô hiệu hóa Job {mã Job}"\nThẻ trạng thái chuyển sang "Ngừng hoạt động"
else Job đang ở trạng thái Ngừng hoạt động
  NSD -> MH_DS : Chọn "Kích hoạt"
  MH_DS -> HT_LOGIC : Đổi trạng thái Job
  HT_LOGIC -> HT_JOB : Cập nhật trạng thái sang Hoạt động
  HT_JOB -> HT_SCH : Đăng ký lại lịch chạy theo biểu thức Cron
  HT_JOB -> CSDL : Cập nhật JOB_DEFINITION
  HT_JOB -> CSDL : Ghi JOB_AUDIT_HISTORY
  MH_DS --> NSD : SUC_003 "Đã kích hoạt Job {mã Job}"\nThẻ trạng thái chuyển sang "Hoạt động"
end

note over MH_DS, CSDL
  Vô hiệu hóa Job đang có lượt chạy dở dang: lượt chạy hiện tại
  vẫn tiếp tục tới khi kết thúc, chỉ các lượt tiếp theo bị gỡ khỏi
  lịch tự động (WAR_002).
end note

== Xóa Job ==
alt Vai trò có quyền xóa
  NSD -> MH_DS : Chọn "Xóa"
  MH_DS -> HT_JOB : Yêu cầu xóa Job
  activate HT_JOB
  alt Job đang được Job khác khai báo là phụ thuộc
    HT_JOB --> MH_DS : Từ chối xóa
    MH_DS --> NSD : ERR_023 "Không thể xóa Job vì đang có Job khác phụ thuộc"
  else Không có ràng buộc phụ thuộc
    HT_JOB -> CSDL : Đánh dấu xóa bản ghi JOB_DEFINITION
    HT_JOB -> CSDL : Ghi JOB_AUDIT_HISTORY
    HT_JOB --> MH_DS : Thành công
    MH_DS --> NSD : SUC_007 "Đã xóa Job {mã Job}"
  end
  deactivate HT_JOB
else Vai trò không có quyền xóa
  MH_DS --> NSD : Mục "Xóa" không xuất hiện trên menu thao tác
end
deactivate MH_DS

@enduml
